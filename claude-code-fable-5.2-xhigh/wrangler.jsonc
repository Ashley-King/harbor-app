{
  // Cloudflare Workers config: the built site as static files, plus one Worker for /api/*.
  // Deploy with: npm run build && npx wrangler deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harbor-claude-code-fable-52-xhigh",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The data endpoint, and the page itself (so http and www are redirected first).
    "run_worker_first": ["/api/*", "/"]
  },
  // The site's own address. Cloudflare creates the DNS records and certificates itself
  // on deploy. The domain must be a zone on the same Cloudflare account.
  "routes": [
    { "pattern": "charlestonharborwatch.com", "custom_domain": true },
    { "pattern": "www.charlestonharborwatch.com", "custom_domain": true }
  ],
  // The harbor log lives in one Workers KV record. No id is given here on purpose:
  // Wrangler creates the namespace on the first deploy and remembers it.
  "kv_namespaces": [{ "binding": "HARBOR_LOG" }],
  // Every ten minutes the Worker notes which ships are in the harbor, for the log.
  "triggers": { "crons": ["*/10 * * * *"] },
  // No second public address: the site answers on its own domain only.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
